rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for Book entity
    function isValidBook(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 300 &&
        data.author is string && data.author.size() <= 200 &&
        data.themeId is string && data.themeId.size() <= 100 &&
        data.chapters is list && data.chapters.size() <= 10;
    }

    // 3. User profile path
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && incoming().userId == request.auth.uid;
      allow update: if isOwner(userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // 4. User's private book monographs
      match /books/{bookId} {
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId) && 
          isValidId(bookId) && 
          isValidBook(incoming(), userId);
        
        allow update: if isOwner(userId) && 
          isValidId(bookId) && 
          incoming().userId == existing().userId && 
          incoming().id == existing().id && 
          isValidBook(incoming(), userId);
        
        allow delete: if isOwner(userId) && isValidId(bookId);
      }
    }
  }
}
